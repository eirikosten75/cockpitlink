<?xml version="1.0" encoding="utf-8"?>
<!-- Package manifest for the Microsoft Store version of CockpitLink. msix/make_package.py fills in the version.
     Identity comes from Partner Center -> CockpitLink -> Product identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop desktop6 rescap">

  <Identity Name="eirik75.CockpitLink"
            Publisher="CN=23571566-DB89-42B4-845C-A11C09BCF99A"
            Version="{VERSION}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>CockpitLink</DisplayName>
    <PublisherDisplayName>eirik75</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Write straight to %LOCALAPPDATA%\CockpitLink, so the setup is shared with the zip version and kept when the
         app is reinstalled (needs the restricted capability unvirtualizedResources below). -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-gb" />
  </Resources>

  <Applications>
    <Application Id="CockpitLink" Executable="CockpitLink.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="CockpitLink"
        Description="Lights the LEDs on your Virpil panels from Microsoft Flight Simulator 2020/2024."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square71x71Logo="Assets\SmallTile.png"
                         Square310x310Logo="Assets\LargeTile.png"
                         ShortName="CockpitLink" />
      </uap:VisualElements>
      <Extensions>
        <!-- Start with Windows: switched by the user in Windows Settings -> Apps -> Startup. -->
        <desktop:Extension Category="windows.startupTask" Executable="CockpitLink.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="CockpitLinkStartup" Enabled="false" DisplayName="CockpitLink" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
