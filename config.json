  "rules": [
    {
      "name": "Left gear",
      "simvar": "GEAR_LEFT_POSITION",
      "device": "cp2",
      "led": "gear_left",
      "states": [
        { "if": ">= 0.99", "color": "geargreen" },
        { "if": "<= 0.01", "color": "gearupblue" },
        { "color": "gearred", "blink": true }
      ]
    },
    {
      "name": "Nose gear",
      "simvar": "GEAR_CENTER_POSITION",
      "only_if": { "simvar": "IS_TAIL_DRAGGER", "if": "== 0" },
      "otherwise": "off",
      "device": "cp2",
      "led": "gear_nose",
      "states": [
        { "if": ">= 0.99", "color": "geargreen" },
        { "if": "<= 0.01", "color": "gearupblue" },
        { "color": "gearred", "blink": true }
      ]
    },
    {
      "name": "Right gear",
      "simvar": "GEAR_RIGHT_POSITION",
      "device": "cp2",
      "led": "gear_right",
      "states": [
        { "if": ">= 0.99", "color": "geargreen" },
        { "if": "<= 0.01", "color": "gearupblue" },
        { "color": "gearred", "blink": true }
      ]
    },
    {
      "name": "Parking brake",
      "simvar": "BRAKE_PARKING_POSITION",
      "device": "cp2",
      "led": "b1",
      "states": [{ "if": "> 0", "color": "brakered" }, { "color": "startup" }]
    },
    {
      "name": "Autopilot",
      "simvar": "AUTOPILOT_MASTER",
      "device": "throttle",
      "led": "b1",
      "states": [{ "if": "== 1", "color": "apgreen" }, { "color": "startup" }]
    },
    {
      "name": "Nav lights",
      "simvar": "LIGHT_NAV_ON",
      "device": "cp2",
      "led": "b2",
      "states": [{ "if": "== 1", "color": "navgreen" }, { "color": "startup" }]
    },
    {
      "name": "Canopy",
      "simvar": "CANOPY_OPEN",
      "device": "cp2",
      "led": "ind_top",
      "states": [
        { "if": "moving", "color": "gearred", "blink": true },
        { "if": "<= 0.01", "color": "geargreen" },
        { "color": "brakered" }
      ]
    },
    {
      "name": "Fuel pressure",
      "simvar": "GENERAL_ENG_FUEL_PRESSURE:1",
      "device": "cp2",
      "led": "ind_center",
      "states": [{ "if": "< 8", "color": "brakered" }, { "color": "geargreen" }]
    },
    {
      "name": "Left flaps",
      "simvar": "TRAILING_EDGE_FLAPS_LEFT_PERCENT",
      "device": "cp2",
      "led": "ind_bottom_left",
      "states": [
        { "if": "moving", "color": "gearred", "blink": true },
        { "if": "<= 0.01", "color": "off" },
        { "color": "geargreen" }
      ]
    },
    {
      "name": "Right flaps",
      "simvar": "TRAILING_EDGE_FLAPS_RIGHT_PERCENT",
      "device": "cp2",
      "led": "ind_bottom_right",
      "states": [
        { "if": "moving", "color": "gearred", "blink": true },
        { "if": "<= 0.01", "color": "off" },
        { "color": "geargreen" }
      ]
    }
  ]
